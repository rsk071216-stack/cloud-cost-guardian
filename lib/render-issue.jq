# render-issue.jq - findings.json -> issue.md (body of the single "Weekly cloud savings report" issue)
# Args: $run_url (may be ""), $top (number of findings to list)
include "format";

. as $doc
| .summary as $s
| ([.findings[] | select(.monthly_cost_estimate > 0)][0:($top | tonumber)]) as $top_findings
| [
    "**Estimated saving: \($s.estimated_monthly_saving | money) per month (\($s.estimated_annual_saving | money) per year)** across \($s.findings_with_saving) actionable findings, plus \($s.governance_findings) governance, hygiene or unpriced findings.",
    "",
    "Scan: \($doc.generated_at) | Clouds: \(if ($doc.providers | length) == 0 then "none" else ($doc.providers | map(cloud_label) | join(", ")) end) | Rules failed: \($doc.rules_failed | length)",
    "",
    "### Top \($top_findings | length) findings",
    "",
    (if ($top_findings | length) == 0 then "No findings with a direct saving this week."
     else
       "| # | Cloud | Resource | Rule | Est. $/month | Risk |",
       "|---:|---|---|---|---:|---|",
       ($top_findings | to_entries[] | .key as $i | .value
         | "| \($i + 1) | \(.provider | cloud_label) | `\(.resource_name | md)` | `\(.rule_id)` | \(.monthly_cost_estimate | money) | \(.risk | risk_label) |")
     end),
    "",
    (if $run_url == "" then "The full Markdown and HTML report is in the `cost-report` artifact of the workflow run."
     else "Full Markdown and HTML report: download the `cost-report` artifact from [this workflow run](\($run_url))." end),
    "",
    "<sub>Generated by cloud-cost-guardian \($doc.tool.version). Read-only scan, recommendations only. Figures are list-price estimates. This issue is updated in place every week.</sub>"
  ]
| join("\n")
